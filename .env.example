# OpenCode Go (or any OpenAI-compatible) model gateway key.
# Used server-side only — never exposed to the client.
OPENCODE_API_KEY=your-opencode-go-key-here

# Optional fallback key if OPENCODE_API_KEY is not set.
OPENROUTER_FREE_KEY=

# Better Auth session signing secret (generate a long random string).
BETTER_AUTH_SECRET=generate-a-long-random-secret

# Public base URL of the deployment (optional in dev).
BETTER_AUTH_URL=http://localhost:5173

# GitHub OAuth app credentials (https://github.com/settings/developers).
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# PUBLIC_CONVEX_URL is created automatically by `convex dev` into .env.local.
# PUBLIC_CONVEX_URL=
